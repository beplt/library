@model Book
@{
    ViewData["Title"] = "Edit a book";
}

<div class="form-wrap">
    <div class="form-side">
        <h1 class="h2">Edit a book</h1>
        <p class="mb-0">Change the title, category or price, then save.</p>
    </div>

    <form asp-action="Edit" method="post" class="form-panel">
        <input type="hidden" asp-for="BookId" />

        <div asp-validation-summary="ModelOnly" class="form-alert mb-3"></div>

        <div class="form-step">
            <span class="step-num">1</span>
            <div class="form-step-body">
                <label asp-for="Title" class="form-label">What is the book called?</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
        </div>
        <div class="form-step">
            <span class="step-num">2</span>
            <div class="form-step-body">
                <label asp-for="Category" class="form-label">Which category?</label>
                <select asp-for="Category" class="form-select">
                    <option value="">(none)</option>
                    <option>Classic</option>
                    <option>Fiction</option>
                    <option>Poetry</option>
                    <option>Reference</option>
                    <option>Textbook</option>
                </select>
            </div>
        </div>
        <div class="form-step">
            <span class="step-num">3</span>
            <div class="form-step-body">
                <label asp-for="Price" class="form-label">How much does it cost?</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
