@model List<Book>
@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="mb-0">Books</h1>
        <p class="text-muted mb-0">@Model.Count books in the catalogue</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="btn-group" role="group" aria-label="Switch view">
            <button type="button" id="btnShelf" class="btn btn-outline-secondary active">Book view</button>
            <button type="button" id="btnTable" class="btn btn-outline-secondary">Table view</button>
        </div>
        <a asp-action="Create" class="btn btn-primary">Add a book</a>
    </div>
</div>

<!-- BOOK VIEW -->
<div id="shelfView" class="shelf">
    @foreach (var book in Model)
    {
        <div class="book-item">
            <div class="book-cover cover-@(book.BookId % 6)">
                <span class="book-cat">@(book.Category ?? "Book")</span>
                <h3 class="book-title">@book.Title</h3>
            </div>

            <div class="book-info">
                <div class="book-info-text">
                    <p class="book-caption" title="@book.Title">@book.Title</p>
                    <p class="book-price">@(book.Price?.ToString("N2") ?? "-")</p>
                </div>

                <div class="dropdown">
                    <button type="button" class="btn-dots" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Options for @book.Title">&#8942;</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@book.BookId">Edit</a></li>
                        <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@book.BookId">Delete</a></li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

<!-- TABLE VIEW -->
<div id="tableView" class="d-none">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th class="text-end" style="width:4rem">#</th>
                <th>Title</th>
                <th>Category</th>
                <th class="text-end">Price</th>
                <th style="width:10rem"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td class="text-end">@book.BookId</td>
                    <td>@book.Title</td>
                    <td><span class="badge text-bg-secondary">@(book.Category ?? "-")</span></td>
                    <td class="text-end">@(book.Price?.ToString("N2") ?? "-")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        const shelf = document.getElementById('shelfView');
        const table = document.getElementById('tableView');
        const btnShelf = document.getElementById('btnShelf');
        const btnTable = document.getElementById('btnTable');

        function showView(view) {
            const isShelf = view === 'shelf';
            shelf.classList.toggle('d-none', !isShelf);
            table.classList.toggle('d-none', isShelf);
            btnShelf.classList.toggle('active', isShelf);
            btnTable.classList.toggle('active', !isShelf);
            try { localStorage.setItem('booksView', view); } catch (e) { }
        }

        btnShelf.addEventListener('click', () => showView('shelf'));
        btnTable.addEventListener('click', () => showView('table'));

        let saved = 'shelf';
        try { saved = localStorage.getItem('booksView') || 'shelf'; } catch (e) { }
        showView(saved);
    </script>
}