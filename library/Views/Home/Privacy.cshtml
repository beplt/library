@{
    ViewData["Title"] = "Privacy";
}

<section class="hero text-center pb-3">
    <p class="hero-kicker">Your information</p>
    <h1 class="hero-title">Privacy</h1>
    <p class="hero-sub">Short, simple, and honest.</p>
</section>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">

                <h2 class="h4">What we keep</h2>
                <p>Arwen's Library only stores what it needs to run the catalogue: each member's name, email address, and member type, plus the details of the books (title, category, and price).</p>

                <h2 class="h4">How we use it</h2>
                <p>Your details are used to manage library records and nothing else. We don't sell them, share them, or send you surprise emails.</p>

                <h2 class="h4">Who can see it</h2>
                <p>Only the people who run this library can view the member directory. Members can't see each other's information.</p>

                <h2 class="h4">Changing or removing your info</h2>
                <p>If something is wrong or you'd like your record deleted, just ask the librarian and it will be updated or removed.</p>

                <h2 class="h4">A note</h2>
                <p class="mb-0 text-muted">This is a sample privacy page made for a school project. Last updated October 2026.</p>

            </div>
        </div>
    </div>
</div>