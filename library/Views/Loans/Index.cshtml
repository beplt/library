@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
    var outCount = Model.Count(l => l.ReturnedOn == null);
    var overdueCount = Model.Count(l => l.Status == "Overdue");
    var returnedCount = Model.Count(l => l.ReturnedOn != null);
    var groups = Model.GroupBy(l => new { l.MemberId, l.MemberName }).ToList();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="mb-0">Loans</h1>
        <p class="text-muted mb-0">@Model.Count loans, newest first</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="btn-group" role="group" aria-label="Switch view">
            <button type="button" id="btnCards" class="btn btn-outline-secondary active">Card view</button>
            <button type="button" id="btnTable" class="btn btn-outline-secondary">Table view</button>
        </div>
        <a asp-action="Borrow" class="btn btn-primary">➕ Borrow a book</a>
    </div>
</div>

<div class="stat-grid mb-4">
    <div class="stat stat-out">
        <div class="stat-num">@outCount</div>
        <div class="stat-label">Books out</div>
    </div>
    <div class="stat stat-overdue">
        <div class="stat-num">@overdueCount</div>
        <div class="stat-label">Overdue</div>
    </div>
    <div class="stat stat-returned">
        <div class="stat-num">@returnedCount</div>
        <div class="stat-label">Returned</div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="display-6">📭</div>
        <p class="mb-0">No loans yet. Borrow a book to get started.</p>
    </div>
}

<!-- CARD VIEW -->
<div id="cardView" class="loan-cards">
    @foreach (var g in groups)
    {
        var name = g.Key.MemberName;
        var parts = name.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        var initials = parts.Length > 1 ? (parts[1][0].ToString() + parts[0][0]).ToUpper() : (name.Length > 0 ? name.Substring(0, 1).ToUpper() : "?");
        var openCount = g.Count(l => l.ReturnedOn == null);

        <div class="member-card">
            <div class="member-card-head">
                <div class="avatar cover-@(g.Key.MemberId % 6)">@initials</div>
                <div class="member-card-name">
                    <h2 class="h5 mb-0">
                        <a asp-controller="Members" asp-action="Details" asp-route-id="@g.Key.MemberId">@name</a>
                    </h2>
                    <span class="text-muted small">@openCount out · @g.Count() total</span>
                </div>
                <a asp-action="Borrow" class="btn btn-sm btn-primary">➕ Add</a>
            </div>

            <div class="loan-list">
                <div class="loan-row loan-row-head">
                    <div>Books borrowed</div>
                    <div>Date borrowed</div>
                    <div>Due</div>
                    <div>Status</div>
                    <div></div>
                </div>
                @foreach (var loan in g)
                {
                    <div class="loan-row">
                        <div class="loan-book">📖 @loan.BookTitle</div>
                        <div class="loan-date">@(loan.LoanedOn.ToString("yyyy-MM-dd"))</div>
                        <div class="loan-date">@(loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd"))</div>
                        <div><span class="status status-@(loan.Status.ToLower())">@loan.Status</span></div>
                        <div class="loan-action">
                            @if (loan.ReturnedOn == null)
                            {
                                <form asp-action="Return" asp-route-id="@loan.LoanId" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-success">↩ Return</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- TABLE VIEW -->
<div id="tableView" class="d-none">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Member</th>
                <th>Book</th>
                <th>Loaned</th>
                <th>Due</th>
                <th>Status</th>
                <th style="width:8rem"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model)
            {
                <tr>
                    <td>@loan.MemberName</td>
                    <td>@loan.BookTitle</td>
                    <td>@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                    <td>@(loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd"))</td>
                    <td><span class="status status-@(loan.Status.ToLower())">@loan.Status</span></td>
                    <td class="text-end">
                        @if (loan.ReturnedOn == null)
                        {
                            <form asp-action="Return" asp-route-id="@loan.LoanId" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-success">↩ Return</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        const cardView = document.getElementById('cardView');
        const tableView = document.getElementById('tableView');
        const btnCards = document.getElementById('btnCards');
        const btnTable = document.getElementById('btnTable');

        function showView(view) {
            const isCards = view === 'cards';
            cardView.classList.toggle('d-none', !isCards);
            tableView.classList.toggle('d-none', isCards);
            btnCards.classList.toggle('active', isCards);
            btnTable.classList.toggle('active', !isCards);
            try { localStorage.setItem('loansView', view); } catch (e) { }
        }

        btnCards.addEventListener('click', () => showView('cards'));
        btnTable.addEventListener('click', () => showView('table'));

        let saved = 'cards';
        try { saved = localStorage.getItem('loansView') || 'cards'; } catch (e) { }
        showView(saved);
    </script>
}