@model MemberDetails
@{
    ViewData["Title"] = Model.Member.FullName;
    var name = Model.Member.FullName;
    var parts = name.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length > 1 ? (parts[1][0].ToString() + parts[0][0]).ToUpper() : (name.Length > 0 ? name.Substring(0, 1).ToUpper() : "?");
    var outCount = Model.Loans.Count(l => l.ReturnedOn == null);
    var overdueCount = Model.Loans.Count(l => l.Status == "Overdue");
    var returnedCount = Model.Loans.Count(l => l.ReturnedOn != null);
}

<div class="member-hero">
    <div class="avatar avatar-lg cover-@(Model.Member.MemberId % 6)">@initials</div>
    <div>
        <h1 class="mb-1">@Model.Member.FullName</h1>
        <span class="chip-type">@Model.Member.MemberType</span>
        <span class="text-muted ms-2">✉️ @(Model.Member.Email ?? "no email")</span>
    </div>
</div>

<div class="stat-grid mb-4">
    <div class="stat stat-out">
        <div class="stat-num">@outCount</div>
        <div class="stat-label">Books out</div>
    </div>
    <div class="stat stat-overdue">
        <div class="stat-num">@overdueCount</div>
        <div class="stat-label">Overdue</div>
    </div>
    <div class="stat stat-returned">
        <div class="stat-num">@returnedCount</div>
        <div class="stat-label">Returned</div>
    </div>
</div>

<h2 class="h4 mb-3">Loan history</h2>
@if (Model.Loans.Count == 0)
{
    <div class="empty-state">
        <div class="display-6">📭</div>
        <p class="mb-0">This member has never borrowed a book.</p>
    </div>
}
else
{
    <div class="member-card">
        <div class="loan-list">
            <div class="loan-row loan-row-4 loan-row-head">
                <div>Book</div>
                <div>Loaned</div>
                <div>Returned</div>
                <div>Status</div>
            </div>
            @foreach (var loan in Model.Loans)
            {
                <div class="loan-row loan-row-4">
                    <div class="loan-book">📖 @loan.BookTitle</div>
                    <div class="loan-date">@(loan.LoanedOn.ToString("yyyy-MM-dd"))</div>
                    <div class="loan-date">@(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "Not yet")</div>
                    <div><span class="status status-@(loan.Status.ToLower())">@loan.Status</span></div>
                </div>
            }
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-link px-0 mt-3">← Back to members</a>