@model Note
@{
    ViewData["Title"] = "Add a note";
}

<div class="form-wrap">
    <div class="form-side">
        <h1 class="h2">Add a note</h1>
        <p class="mb-0">Give the note a title, then write what you want to remember.</p>
    </div>

    <form asp-action="Create" method="post" class="form-panel">
        <div asp-validation-summary="ModelOnly" class="form-alert mb-3"></div>

        <div class="form-step">
            <span class="step-num">1</span>
            <div class="form-step-body">
                <label asp-for="Title" class="form-label">What is the title?</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
        </div>
        <div class="form-step">
            <span class="step-num">2</span>
            <div class="form-step-body">
                <label asp-for="Body" class="form-label">What do you want to write?</label>
                <textarea asp-for="Body" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Body" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </div>
    </form>
</div>
